# Токен backend; генератор создаёт случайное значение. Скопируйте в расширение.
API_TOKEN=
# Токен ZenMoney остаётся только на сервере. Для проверки запуска можно оставить пустым.
ZENMONEY_TOKEN=
# Контейнерный путь внутри постоянного тома; обязательно абсолютный.
DATABASE_PATH=/data/zenimport.sqlite3
# Отдельный том нового backend. Рабочий том прежнего приложения сюда не подключать.
DATA_VOLUME=zenimport-backend-data
# Отдельный порт, чтобы прежний ZenImport мог продолжать работать.
HTTP_PORT=18792
COMPOSE_PROJECT_NAME=zenimport-backend
