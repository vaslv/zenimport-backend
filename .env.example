# Backend token; the generator creates a random value. Copy it into the extension.
API_TOKEN=
# The ZenMoney token stays on the server. Leave empty when only checking startup.
ZENMONEY_TOKEN=
# Container path within the persistent volume; must be absolute.
DATABASE_PATH=/data/zenimport.sqlite3
# Separate volume for the new backend. Do not mount the legacy production volume here.
DATA_VOLUME=zenimport-backend-data
# Separate port so that the legacy ZenImport can keep running.
HTTP_PORT=18792
COMPOSE_PROJECT_NAME=zenimport-backend
