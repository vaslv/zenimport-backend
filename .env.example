# Токен нашего backend: генератор создаёт случайное значение.
API_TOKEN=
# demo — учебные данные; live — чтение настоящего ZenMoney.
ZENMONEY_MODE=demo
# Токен ZenMoney. Вставьте значение после получения; не заменяйте API_TOKEN.
ZENMONEY_TOKEN=
# Адрес локального Docker backend: http://127.0.0.1:18791
HTTP_PORT=18791
# Имя Compose-проекта; влияет на названия контейнеров и томов.
COMPOSE_PROJECT_NAME=zenimport
# Только для запуска без Docker. В Docker БД всегда /data/zenimport.sqlite3.
DATABASE_PATH=data/demo.sqlite3
# Только для запуска без Docker. Внутренний порт Docker всегда 8000.
PORT=8000
