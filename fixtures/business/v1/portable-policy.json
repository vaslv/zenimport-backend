{
  "activation": "architecture.md participant handoff for live migration; explicit archive-only recovery is distinct",
  "archive_version": 2,
  "canonical_encoding": {
    "blob_scalar": "canonical padded base64",
    "dataset_digest": "SHA256 of compact JSON descriptor plus LF; descriptor fixed property order: financial_schema_version,dataset_id,zenmoney_identity,required_features,tables; table fixed property order: name,filename,columns,rows,bytes,sha256; table list sorted by UTF-8 filename, owner_ids/features sorted by UTF-8 bytes; excludes producer/archive time/session IDs",
    "empty_table": "zero bytes; SHA256 of empty bytes",
    "format": "UTF-8 compact JSON, LF terminator, no BOM, no lone Unicode surrogates",
    "integer_scalar": "canonical signed decimal string; no -0, exponent or leading zero",
    "row_order": "primary-key tuple; integers compared numerically, text by UTF-8 byte order, blob by decoded bytes; NULL first only where logically allowed",
    "strings": "JSON escaping for control characters, quote and backslash; Unicode otherwise literal"
  },
  "contract_version": 1,
  "financial_schema_version": 1,
  "limits": {
    "compressed_bytes": 67108864,
    "manifest_bytes": 65536,
    "row_bytes": 134217728,
    "tables": 100,
    "uncompressed_bytes": 268435456
  },
