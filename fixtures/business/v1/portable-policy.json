    "category_predictions": "invalidate derived applicability after source generation change",
    "delivery_authorizations": "attempted immutable; only unattempted source binding may be revalidated",
    "service_meta": "explicit allowlist; instance_id becomes lineage, not installation identity",
    "source_capture_leases": "empty executable set after quiescence; orphan locks cause export validation failure",
    "source_schema_migrations.backup_path": "null; host path is not portable",
    "zen_mirror_state": "preserve audit; destination needs_full=1 ready=0 fresh cursor context"
