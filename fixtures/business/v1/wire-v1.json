    "$defs": {
      "BankRecord": {
        "additionalProperties": false,
        "properties": {
          "amount": {
            "pattern": "^(?:0|[1-9][0-9]{0,23})(?:\\.[0-9]{1,12})?$",
            "title": "Amount",
            "type": "string"
          },
          "balance": {
            "anyOf": [
              {
                "pattern": "^-?(?:0|[1-9][0-9]{0,23})(?:\\.[0-9]{1,12})?$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Balance"
          },
          "beneficiary_account": {
            "anyOf": [
              {
                "maxLength": 240,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
