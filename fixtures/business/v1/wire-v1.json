              {
                "maxLength": 2000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Beneficiary Name"
          },
          "currency": {
            "pattern": "^[A-Z]{3,12}$",
            "title": "Currency",
            "type": "string"
          },
          "description": {
            "maxLength": 2000,
            "title": "Description",
            "type": "string"
          },
          "details": {
            "additionalProperties": {
              "maxLength": 2000,
              "type": "string"
            },
            "maxProperties": 64,
            "propertyNames": {
              "maxLength": 240,
              "minLength": 1
            },
            "title": "Details",
            "type": "object"
          },
          "details_state": {
            "enum": [
              "complete",
              "unavailable"
            ],
            "title": "Details State",
            "type": "string"
          },
          "direction": {
            "enum": [
              "expense",
              "income"
            ],
            "title": "Direction",
            "type": "string"
          },
          "external_id": {
            "maxLength": 240,
            "minLength": 1,
            "title": "External Id",
            "type": "string"
          },
          "identity_kind": {
            "enum": [
              "bank",
              "fingerprint"
            ],
            "title": "Identity Kind",
            "type": "string"
          },
          "identity_version": {
            "maxLength": 40,
            "minLength": 1,
            "title": "Identity Version",
            "type": "string"
          },
          "local_date": {
            "format": "date",
            "title": "Local Date",
            "type": "string"
          },
          "occurred_at": {
            "format": "date-time",
            "title": "Occurred At",
            "type": "string"
          }
        },
        "required": [
          "external_id",
          "identity_kind",
          "identity_version",
          "occurred_at",
          "local_date",
          "direction",
          "amount",
          "currency",
          "description",
          "details_state"
        ],
        "title": "BankRecord",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "lease_epoch": {
        "minimum": 1,
        "title": "Lease Epoch",
        "type": "integer"
      },
      "page_number": {
        "minimum": 1,
        "title": "Page Number",
        "type": "integer"
      },
      "records": {
        "items": {
          "$ref": "#/$defs/BankRecord"
        },
        "maxItems": 500,
        "title": "Records",
        "type": "array"
      },
      "total_pages": {
        "maximum": 10000,
        "minimum": 1,
        "title": "Total Pages",
        "type": "integer"
      },
      "total_records": {
        "maximum": 1000000,
        "minimum": 0,
        "title": "Total Records",
        "type": "integer"
      },
      "worker_id": {
        "format": "uuid",
        "title": "Worker Id",
        "type": "string"
      }
    },
    "required": [
      "worker_id",
      "lease_epoch",
      "page_number",
      "total_pages",
      "total_records",
      "records"
    ],
